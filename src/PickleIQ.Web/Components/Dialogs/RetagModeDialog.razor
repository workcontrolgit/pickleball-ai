@using PickleIQ.Core.Entities
@using MudBlazor

<MudDialog>
    <DialogContent>
        <MudText Typo="Typo.body1" Class="mb-4">
            Select the new mode. Existing analysis results will be cleared and the video will be reprocessed.
        </MudText>
        <MudRadioGroup T="VideoMode" @bind-Value="_mode">
            <MudRadio Value="VideoMode.Match" Color="Color.Primary">
                <MudText Typo="Typo.body1"><strong>Match</strong> — fixed cam, requires 2+ players per frame</MudText>
            </MudRadio>
            <MudRadio Value="VideoMode.Training" Color="Color.Secondary">
                <MudText Typo="Typo.body1"><strong>Training</strong> — solo, singles, or doubles drills</MudText>
            </MudRadio>
            <MudRadio Value="VideoMode.FollowCam" Color="Color.Tertiary">
                <MudText Typo="Typo.body1"><strong>Follow-Cam</strong> — Osmo tracking one player in a match</MudText>
            </MudRadio>
        </MudRadioGroup>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Warning" Variant="Variant.Filled" OnClick="Confirm">Reprocess</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter] public VideoMode CurrentMode { get; set; } = VideoMode.Match;

    private VideoMode _mode;

    protected override void OnParametersSet() => _mode = CurrentMode;

    private void Cancel() => MudDialog.Cancel();
    private void Confirm() => MudDialog.Close(DialogResult.Ok(_mode));
}
