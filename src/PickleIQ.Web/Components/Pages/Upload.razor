@page "/upload"
@using PickleIQ.Core.Interfaces
@using PickleIQ.Core.Entities
@using Microsoft.Extensions.Configuration
@inject IVideoStorageService VideoStorageService
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject IConfiguration Configuration

<PageTitle>Upload Match Video — PickleIQ</PageTitle>

<MudText Typo="Typo.h4" Class="mb-1">Upload Your Match Video</MudText>
<MudText Typo="Typo.body1" Color="Color.Secondary" Class="mb-6">
    Upload an MP4 of your match or training session and receive an AI-generated highlight reel and coaching report.
</MudText>

<MudPaper MaxWidth="600px" Class="pa-6 mx-auto" Elevation="2">
    @if (!_uploading)
    {
        <MudRadioGroup T="VideoMode" @bind-Value="_selectedMode" Class="mb-4">
            <MudStack Row="true" Spacing="3">
                <MudRadio Value="VideoMode.Match" Color="Color.Primary">
                    <MudStack Spacing="0">
                        <MudText Typo="Typo.body1"><strong>Match</strong></MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Fixed cam, 2–4 players</MudText>
                    </MudStack>
                </MudRadio>
                <MudRadio Value="VideoMode.Training" Color="Color.Secondary">
                    <MudStack Spacing="0">
                        <MudText Typo="Typo.body1"><strong>Training</strong></MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Solo, singles, or doubles drills</MudText>
                    </MudStack>
                </MudRadio>
                <MudRadio Value="VideoMode.FollowCam" Color="Color.Tertiary">
                    <MudStack Spacing="0">
                        <MudText Typo="Typo.body1"><strong>Follow-Cam</strong></MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Osmo tracking one player in a match</MudText>
                    </MudStack>
                </MudRadio>
            </MudStack>
        </MudRadioGroup>
        @* Hidden native file input — Blazor reads files from this *@
        <InputFile id="upload-input" style="display:none"
                   accept=".mp4,.MP4,.mov,.MOV"
                   OnChange="OnFileSelected" />

        <div id="upload-drop-zone" class="upload-drop-zone">
            <MudStack AlignItems="AlignItems.Center" Spacing="2">
                <MudIcon Icon="@Icons.Material.Filled.CloudUpload"
                         Color="@(_isDragging ? Color.Primary : Color.Secondary)"
                         Style="font-size:3rem;" />
                <MudText Typo="Typo.h6">
                    @(_isDragging ? "Drop to upload" : "Drag & drop your video here")
                </MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">or click to browse</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">MP4 or MOV · up to @_maxFileSizeGb GB</MudText>
            </MudStack>
        </div>

        @if (_selectedFile is not null)
        {
            <MudStack Row="true" AlignItems="AlignItems.Center" Class="mt-4 mb-2" Spacing="2">
                <MudIcon Icon="@Icons.Material.Filled.VideoFile" Color="Color.Primary" />
                <MudText><strong>@_selectedFile.Name</strong> — @FormatBytes(_selectedFile.Size)</MudText>
            </MudStack>

            @if (_selectedFile.Size > MaxFileSizeBytes)
            {
                <MudAlert Severity="Severity.Error" Class="mb-3">
                    File exceeds the @_maxFileSizeGb GB limit. Please select a smaller file.
                </MudAlert>
            }
            else
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                           Size="Size.Large" OnClick="UploadAsync"
                           StartIcon="@Icons.Material.Filled.Analytics">
                    Analyze Video
                </MudButton>
            }
        }

        @if (_errorMessage is not null)
        {
            <MudAlert Severity="Severity.Error" Class="mt-4">@_errorMessage</MudAlert>
        }
    }
    else
    {
        <MudStack AlignItems="AlignItems.Center" Spacing="4" Class="py-4">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
            <MudText>Uploading your video, please wait...</MudText>
        </MudStack>
    }
</MudPaper>

@code {
    private long _maxFileSizeGb;
    private long MaxFileSizeBytes => _maxFileSizeGb * 1024 * 1024 * 1024;
    private VideoMode _selectedMode = VideoMode.Match;

    private IBrowserFile? _selectedFile;
    private bool _uploading;
    private bool _isDragging;
    private string? _errorMessage;
    private DotNetObjectReference<Upload>? _dotNetRef;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _maxFileSizeGb = Configuration.GetValue<long>("Upload:MaxFileSizeGb", 12);
            _dotNetRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("initUploadDropZone", "upload-drop-zone", "upload-input", _dotNetRef);
        }
    }

    [JSInvokable]
    public void SetDragging(bool dragging)
    {
        _isDragging = dragging;
        StateHasChanged();
    }

    private void OnFileSelected(InputFileChangeEventArgs e)
    {
        _selectedFile = e.File;
        _isDragging = false;
        _errorMessage = null;
    }

    private async Task UploadAsync()
    {
        if (_selectedFile is null) return;

        _uploading = true;
        _errorMessage = null;

        try
        {
            await using var stream = _selectedFile.OpenReadStream(MaxFileSizeBytes);
            var jobId = await VideoStorageService.SaveAsync(stream, _selectedFile.Name, _selectedFile.Size, _selectedMode);
            Navigation.NavigateTo($"/results/{jobId}");
        }
        catch (Exception ex)
        {
            _errorMessage = $"Upload failed: {ex.Message}";
            _uploading = false;
        }
    }

    public void Dispose() => _dotNetRef?.Dispose();

    private static string FormatBytes(long bytes) => bytes switch
    {
        < 1024 => $"{bytes} B",
        < 1024 * 1024 => $"{bytes / 1024} KB",
        < 1024 * 1024 * 1024 => $"{bytes / (1024 * 1024)} MB",
        _ => $"{bytes / (1024L * 1024 * 1024):F1} GB"
    };
}
