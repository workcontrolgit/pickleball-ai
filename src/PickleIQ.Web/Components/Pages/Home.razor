@page "/"

<PageTitle>PickleIQ — AI Pickleball Analysis</PageTitle>

<div class="container mt-5" style="max-width: 680px;">
    <h1 class="mb-1">PickleIQ</h1>
    <p class="lead text-muted mb-4">Upload a match video. Get a highlight reel and AI coaching report — no coach required.</p>

    <div class="d-flex gap-3">
        <a href="/upload" class="btn btn-primary btn-lg">Upload a Video</a>
        <a href="/jobs" class="btn btn-outline-secondary btn-lg">My Videos</a>
    </div>

    <hr class="mt-5" />

    <div class="row text-center mt-4">
        <div class="col">
            <div class="fs-1">🏓</div>
            <h6 class="mt-2">Rally Detection</h6>
            <p class="text-muted small">YOLO AI identifies every active rally in your match footage.</p>
        </div>
        <div class="col">
            <div class="fs-1">🎬</div>
            <h6 class="mt-2">Highlight Reel</h6>
            <p class="text-muted small">Top rallies auto-cut into a 60-second highlight you can share.</p>
        </div>
        <div class="col">
            <div class="fs-1">📊</div>
            <h6 class="mt-2">Coaching Report</h6>
            <p class="text-muted small">AI-generated feedback on strengths, improvements, and drills.</p>
        </div>
    </div>
</div>
