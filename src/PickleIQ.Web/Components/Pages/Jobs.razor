@page "/jobs"
@using Hangfire
@using Microsoft.EntityFrameworkCore
@using PickleIQ.Core.Entities
@using PickleIQ.Infrastructure.Data
@using PickleIQ.Infrastructure.Jobs
@using PickleIQ.Web.Components.Dialogs
@inject AppDbContext Db
@inject IBackgroundJobClient JobClient
@inject IDialogService DialogService

<PageTitle>My Videos — PickleIQ</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">
    <MudText Typo="Typo.h4">My Videos</MudText>
    <MudButton Href="/upload" Variant="Variant.Filled" Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.CloudUpload">
        Upload Video
    </MudButton>
</MudStack>

@if (_jobs is null)
{
    <MudStack AlignItems="AlignItems.Center" Class="mt-8">
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
    </MudStack>
}
else if (_jobs.Count == 0)
{
    <MudStack AlignItems="AlignItems.Center" Class="mt-8" Spacing="4">
        <MudText Color="Color.Secondary">No videos uploaded yet.</MudText>
        <MudButton Href="/upload" Variant="Variant.Filled" Color="Color.Primary">Upload your first video</MudButton>
    </MudStack>
}
else
{
    @* Desktop table *@
    <MudHidden Breakpoint="Breakpoint.SmAndDown">
        <MudTable Items="_jobs" Hover="true" Elevation="2">
            <HeaderContent>
                <MudTh>File</MudTh>
                <MudTh>Status</MudTh>
                <MudTh>Mode</MudTh>
                <MudTh>Uploaded</MudTh>
                <MudTh>Video Size</MudTh>
                <MudTh>Highlight Size</MudTh>
                <MudTh Style="text-align:right">Actions</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>
                    <MudText Typo="Typo.body2" Style="font-weight:600">@context.FileName</MudText>
                </MudTd>
                <MudTd>
                    <MudChip T="string" Color="@ChipColor(context.Status)" Size="Size.Small">
                        @StatusLabel(context.Status)
                    </MudChip>
                </MudTd>
                <MudTd>
                    <MudChip T="string" Color="Color.Default" Size="Size.Small">@ModeLabel(context.Mode)</MudChip>
                </MudTd>
                <MudTd>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                        @context.CreatedAt.ToLocalTime().ToString("MMM d, yyyy h:mm tt")
                    </MudText>
                </MudTd>
                <MudTd>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">@GetFileSize(context.FilePath)</MudText>
                </MudTd>
                <MudTd>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">@GetFileSize(context.HighlightFilePath)</MudText>
                </MudTd>
                <MudTd Style="text-align:right">
                    @ActionButtons(context)
                </MudTd>
            </RowTemplate>
        </MudTable>
    </MudHidden>

    @* Mobile cards *@
    <MudHidden Breakpoint="Breakpoint.MdAndUp">
        <MudStack Spacing="3">
            @foreach (var job in _jobs)
            {
                <MudCard @key="job.Id" Elevation="2">
                    <MudCardContent>
                        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-1">
                            <MudText Typo="Typo.body1" Style="font-weight:600">@job.FileName</MudText>
                            <MudStack Row="true" Spacing="1">
                                <MudChip T="string" Color="Color.Default" Size="Size.Small">@ModeLabel(job.Mode)</MudChip>
                                <MudChip T="string" Color="@ChipColor(job.Status)" Size="Size.Small">
                                    @StatusLabel(job.Status)
                                </MudChip>
                            </MudStack>
                        </MudStack>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                            @job.CreatedAt.ToLocalTime().ToString("MMM d, yyyy h:mm tt")
                        </MudText>
                        <MudStack Row="true" Spacing="3" Class="mb-3">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                Video: @GetFileSize(job.FilePath)
                            </MudText>
                            @if (!string.IsNullOrEmpty(job.HighlightFilePath))
                            {
                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                    Highlights: @GetFileSize(job.HighlightFilePath)
                                </MudText>
                            }
                        </MudStack>
                        <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                            @ActionButtons(job)
                        </MudStack>
                    </MudCardContent>
                </MudCard>
            }
        </MudStack>
    </MudHidden>
}

@code {
    private List<VideoJob>? _jobs;
    private readonly HashSet<Guid> _retrying = [];
    private readonly HashSet<Guid> _deleting = [];
    private readonly HashSet<Guid> _retagging = [];

    protected override async Task OnInitializedAsync() => await LoadJobsAsync();

    private async Task LoadJobsAsync()
    {
        _jobs = await Db.VideoJobs.AsNoTracking()
            .OrderByDescending(j => j.CreatedAt)
            .ToListAsync();
    }

    private RenderFragment ActionButtons(VideoJob job) => __builder =>
    {
        if (job.Status == VideoJobStatus.ReportComplete)
        {
            <MudButton Href="@($"/results/{job.Id}")" Variant="Variant.Filled" Color="Color.Success"
                       Size="Size.Small" StartIcon="@Icons.Material.Filled.Assessment">
                View Results
            </MudButton>
            <MudMenu Icon="@Icons.Material.Filled.MoreVert" Size="Size.Small"
                     AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                @if (!string.IsNullOrEmpty(job.HighlightFilePath))
                {
                    <MudMenuItem Icon="@Icons.Material.Filled.Download"
                                 Href="@($"/download/{job.Id}/highlights")">
                        Download Highlights
                    </MudMenuItem>
                }
                <MudMenuItem Icon="@Icons.Material.Filled.Refresh"
                             Disabled="_retrying.Contains(job.Id)"
                             OnClick="@(async () => await ConfirmReprocessAsync(job.Id))">
                    @(_retrying.Contains(job.Id) ? "Reprocessing…" : "Reprocess")
                </MudMenuItem>
                <MudMenuItem Icon="@Icons.Material.Filled.SwapHoriz"
                             Disabled="_retagging.Contains(job.Id)"
                             OnClick="@(async () => await RetagAndReprocessAsync(job.Id, job.Mode))">
                    @(_retagging.Contains(job.Id) ? "Changing Mode…" : "Change Mode & Reprocess")
                </MudMenuItem>
                <MudDivider />
                <MudMenuItem Icon="@Icons.Material.Filled.Delete"
                             Style="color: var(--mud-palette-error);"
                             Disabled="_deleting.Contains(job.Id)"
                             OnClick="@(async () => await ConfirmDeleteAsync(job))">
                    Delete
                </MudMenuItem>
            </MudMenu>
        }
        else if (job.Status == VideoJobStatus.Failed)
        {
            <MudButton OnClick="@(async () => await RetryAsync(job.Id))" Variant="Variant.Filled"
                       Color="Color.Warning" Size="Size.Small" StartIcon="@Icons.Material.Filled.Refresh"
                       Disabled="_retrying.Contains(job.Id)">
                @(_retrying.Contains(job.Id) ? "Retrying…" : "Retry")
            </MudButton>
            <MudMenu Icon="@Icons.Material.Filled.MoreVert" Size="Size.Small"
                     AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                <MudMenuItem Icon="@Icons.Material.Filled.Info"
                             Href="@($"/results/{job.Id}")">
                    Details
                </MudMenuItem>
                <MudMenuItem Icon="@Icons.Material.Filled.SwapHoriz"
                             Disabled="_retagging.Contains(job.Id)"
                             OnClick="@(async () => await RetagAndReprocessAsync(job.Id, job.Mode))">
                    @(_retagging.Contains(job.Id) ? "Changing Mode…" : "Change Mode & Reprocess")
                </MudMenuItem>
                <MudDivider />
                <MudMenuItem Icon="@Icons.Material.Filled.Delete"
                             Style="color: var(--mud-palette-error);"
                             Disabled="_deleting.Contains(job.Id)"
                             OnClick="@(async () => await ConfirmDeleteAsync(job))">
                    Delete
                </MudMenuItem>
            </MudMenu>
        }
        else
        {
            <MudButton Href="@($"/results/{job.Id}")" Variant="Variant.Outlined"
                       Color="Color.Primary" Size="Size.Small"
                       StartIcon="@Icons.Material.Filled.HourglassEmpty">
                View Progress
            </MudButton>
        }
    };

    private async Task ConfirmDeleteAsync(VideoJob job)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Delete Video",
            $"Delete \"{job.FileName}\"? This will permanently remove the video, highlights, and all analysis data.",
            yesText: "Delete", cancelText: "Cancel");
        if (confirmed != true) return;
        await DeleteAsync(job.Id);
    }

    private async Task ConfirmReprocessAsync(Guid jobId)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Reprocess Video",
            "This will delete the existing analysis results and reprocess the video from scratch.",
            yesText: "Reprocess", cancelText: "Cancel");
        if (confirmed != true) return;
        await RetryAsync(jobId);
    }

    private async Task RetryAsync(Guid jobId)
    {
        _retrying.Add(jobId);
        await InvokeAsync(StateHasChanged);
        var job = await Db.VideoJobs.FindAsync(jobId);
        if (job is not null && (job.Status == VideoJobStatus.Failed || job.Status == VideoJobStatus.ReportComplete))
        {
            Db.RallySegments.RemoveRange(Db.RallySegments.Where(s => s.VideoJobId == jobId));
            var report = await Db.CoachingReports.FirstOrDefaultAsync(r => r.VideoJobId == jobId);
            if (report is not null) Db.CoachingReports.Remove(report);
            job.Status = VideoJobStatus.Queued;
            job.ErrorMessage = null;
            job.HighlightFilePath = null;
            job.CompletedAt = null;
            await Db.SaveChangesAsync();
            try
            {
                JobClient.Enqueue<VideoProcessingJob>(j => j.ProcessAsync(jobId));
            }
            catch
            {
                // Enqueue failed after commit — job is left Queued but no worker will pick it up.
                // The user can retry again from My Videos.
            }
        }
        _retrying.Remove(jobId);
        await LoadJobsAsync();
    }

    private async Task DeleteAsync(Guid jobId)
    {
        _deleting.Add(jobId);
        await InvokeAsync(StateHasChanged);
        var job = await Db.VideoJobs.FindAsync(jobId);
        if (job is not null)
        {
            Db.RallySegments.RemoveRange(Db.RallySegments.Where(s => s.VideoJobId == jobId));
            var report = await Db.CoachingReports.FirstOrDefaultAsync(r => r.VideoJobId == jobId);
            if (report is not null) Db.CoachingReports.Remove(report);
            Db.VideoJobs.Remove(job);
            await Db.SaveChangesAsync();
            DeleteFileIfExists(job.FilePath);
            DeleteFileIfExists(job.HighlightFilePath);
        }
        _deleting.Remove(jobId);
        await LoadJobsAsync();
    }

    private static void DeleteFileIfExists(string? path)
    {
        if (string.IsNullOrEmpty(path)) return;
        var normalized = path.Replace('/', Path.DirectorySeparatorChar).Replace('\\', Path.DirectorySeparatorChar);
        if (File.Exists(normalized)) File.Delete(normalized);
    }

    private static string GetFileSize(string? path)
    {
        if (string.IsNullOrEmpty(path)) return "—";
        try
        {
            var info = new FileInfo(path);
            if (!info.Exists) return "—";
            return info.Length switch
            {
                < 1024 * 1024 => $"{info.Length / 1024} KB",
                < 1024L * 1024 * 1024 => $"{info.Length / (1024.0 * 1024):F1} MB",
                _ => $"{info.Length / (1024.0 * 1024 * 1024):F2} GB"
            };
        }
        catch { return "—"; }
    }

    private static string ModeLabel(VideoMode mode) => mode switch
    {
        VideoMode.Training => "Training",
        _ => "Match"
    };

    private async Task RetagAndReprocessAsync(Guid jobId, VideoMode currentMode)
    {
        var parameters = new DialogParameters<RetagModeDialog> { { d => d.CurrentMode, currentMode } };
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.ExtraSmall };
        var dialog = await DialogService.ShowAsync<RetagModeDialog>("Change Mode & Reprocess", parameters, options);
        var result = await dialog.Result;
        if (result is null || result.Canceled) return;
        var newMode = (VideoMode)result.Data!;

        _retagging.Add(jobId);
        await InvokeAsync(StateHasChanged);
        try
        {
            var job = await Db.VideoJobs.FindAsync(jobId);
            if (job is null) return;
            job.Mode = newMode;
            Db.RallySegments.RemoveRange(Db.RallySegments.Where(s => s.VideoJobId == jobId));
            var report = await Db.CoachingReports.FirstOrDefaultAsync(r => r.VideoJobId == jobId);
            if (report is not null) Db.CoachingReports.Remove(report);
            job.Status = VideoJobStatus.Queued;
            job.ErrorMessage = null;
            job.HighlightFilePath = null;
            job.CompletedAt = null;
            await Db.SaveChangesAsync();
            try { JobClient.Enqueue<VideoProcessingJob>(j => j.ProcessAsync(jobId)); } catch { }
        }
        finally
        {
            _retagging.Remove(jobId);
            await LoadJobsAsync();
            await InvokeAsync(StateHasChanged);
        }
    }

    private static string StatusLabel(VideoJobStatus status) => status switch
    {
        VideoJobStatus.Queued => "Queued",
        VideoJobStatus.RallyDetectionInProgress => "Detecting Rallies",
        VideoJobStatus.RallyDetectionComplete => "Rallies Found",
        VideoJobStatus.HighlightInProgress => "Creating Highlights",
        VideoJobStatus.HighlightComplete => "Highlights Ready",
        VideoJobStatus.ReportInProgress => "Generating Report",
        VideoJobStatus.ReportComplete => "Complete",
        VideoJobStatus.Failed => "Failed",
        _ => "Processing"
    };

    private static Color ChipColor(VideoJobStatus status) => status switch
    {
        VideoJobStatus.ReportComplete => Color.Success,
        VideoJobStatus.Failed => Color.Error,
        VideoJobStatus.Queued => Color.Surface,
        _ => Color.Primary
    };
}
