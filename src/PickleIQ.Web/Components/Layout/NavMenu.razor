<MudAppBar Elevation="1" Color="Color.Primary">
    <MudButton Href="/" Variant="Variant.Text" Color="Color.Inherit" Style="font-weight:700;font-size:1.25rem;letter-spacing:.5px;text-transform:none;">🥒 PickleIQ</MudButton>
    <MudSpacer />
    <MudHidden Breakpoint="Breakpoint.SmAndDown">
        <MudButton Href="/upload" Color="Color.Inherit" StartIcon="@Icons.Material.Filled.CloudUpload">Upload Video</MudButton>
        <MudButton Href="/jobs" Color="Color.Inherit" StartIcon="@Icons.Material.Filled.VideoLibrary">My Videos</MudButton>
    </MudHidden>
</MudAppBar>

<MudHidden Breakpoint="Breakpoint.MdAndUp">
    <MudAppBar Bottom="true" Elevation="1" Color="Color.Primary" Fixed="true">
        <MudButton Href="/upload" Color="Color.Inherit" StartIcon="@Icons.Material.Filled.CloudUpload" FullWidth="true">Upload</MudButton>
        <MudButton Href="/jobs" Color="Color.Inherit" StartIcon="@Icons.Material.Filled.VideoLibrary" FullWidth="true">My Videos</MudButton>
    </MudAppBar>
</MudHidden>
